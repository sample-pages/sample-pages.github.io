<!-- 04 さまざまな参加プラン -->
<template id="detail-04">

  <div class="detail-description">
  <p>
    宿泊プランや日帰りプラン、また、社会人プラン、学生・中高生プランなど、さまざまな参加プランをご用意しています！
<br>
ご都合やご年齢に合ったプランをお選びいただけます。
  </p>
  </div>
</template>

  <script>
  const modal = document.getElementById("featureModal");
  const modalNumber = document.getElementById("modalNumber");
  const modalTitle = document.getElementById("modalTitle");
  const modalBody = document.getElementById("modalBody");
  const modalChart = document.getElementById("modalChart");
  const modalExtra = document.getElementById("modalExtra");

  const cards = document.querySelectorAll(".tag-hover");
  const closeButton = document.querySelector(".modal-close");
  const overlay = document.querySelector(".modal-overlay");

  let previousFocus = null;

  function openModal(card) {
    previousFocus = card;

    const number = card.querySelector(".speech-num").textContent;
    const title = card.dataset.detailTitle;
    const templateId = card.dataset.detailTemplate;

    const template = document.getElementById(templateId);

    modalNumber.textContent = number;
    modalTitle.textContent = title;

    modalBody.replaceChildren();
modalChart.replaceChildren();
modalExtra.replaceChildren();

    if (template) {
      const content = template.content.cloneNode(true);

      const description = content.querySelector(".detail-description");
const chart = content.querySelector(".detail-chart-content");
const extra = content.querySelector(".detail-description-extra");

if (description) {
  modalBody.replaceChildren(...description.childNodes);
}

if (chart) {
  modalChart.replaceChildren(...chart.childNodes);
}

if (extra) {
  modalExtra.replaceChildren(...extra.childNodes);
}
    }

    modal.classList.add("active");
    modal.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";
    closeButton.focus();
  }

  function closeModal() {
    modal.classList.remove("active");
    modal.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";

    previousFocus?.focus();
  }

  cards.forEach(card => {
    card.addEventListener("click", () => {
      openModal(card);
    });
  });

  closeButton.addEventListener("click", closeModal);
  overlay.addEventListener("click", closeModal);

  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && modal.classList.contains("active")) {
      closeModal();
    }
  });
</script>

