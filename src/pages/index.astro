  <style>
  /* =========================
     PICKUP セクション
  ========================= */

  .pickup-section {
  --pickup-side-padding: 150px;

  width: 100%;
  padding: 30px 0 40px;
  overflow: hidden;
}

  /* 見出し */
  .pickup-heading {
  width: 100%;
  padding-left: var(--pickup-side-padding);
  padding-right: 5%;
  margin-bottom: 20px;
}

  .pickup-heading h2 {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
  }

  .pickup-heading-en {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .pickup-heading-ja {
    font-size: 20px;
    font-weight: 600;
  }

  /* =========================
     スライダー
  ========================= */

  .pickup-slider-wrap {
    position: relative;
    width: 100%;
  }

  .pickup-slider {
  display: flex;
  align-items: center;
  gap: 24px;

  overflow-x: auto;
  overflow-y: hidden;

  padding: 24px var(--pickup-side-padding) 30px;

  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;

  scrollbar-width: none;
  -ms-overflow-style: none;
}

  .pickup-slider::-webkit-scrollbar {
    display: none;
  }

  /* =========================
     カード
  ========================= */

  .pickup-card {
    position: relative;
    flex-shrink: 0;

    height: 400px;
    width: auto;

    overflow: hidden;
    border-radius: 28px;

    scroll-snap-align: center;

    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.15);

    transition: transform 0.3s ease;
  }

  .pickup-card:hover {
    transform: scale(1.01);
  }

  .pickup-card a,
  .pickup-card button {
    display: block;
    position: relative;
    height: 100%;
    width: auto;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pickup-card img {
    display: block;
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: cover;
  }

  /* 画像下部のグラデーション */
  .pickup-overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0.65) 100%
    );

    pointer-events: none;
  }

  /* カードのタイトル */
  .pickup-card h3 {
    position: absolute;
    left: 24px;
    bottom: 18px;
    z-index: 2;

    margin: 0;
    padding-right: 12px;

    color: #fff;
    font-size: 24px;
    font-weight: 700;
    white-space: nowrap;

    pointer-events: none;
  }

  /* =========================
     左右のボタン
  ========================= */

  .pickup-arrow {
    position: absolute;
    top: 50%;
    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 58px;
    height: 58px;

    padding: 12px;

    border: 2px solid #222;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.95);
    color: #111;

    cursor: pointer;

    transform: translateY(-50%);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .pickup-arrow:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .pickup-arrow svg {
    width: 100%;
    height: 100%;

    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pickup-prev {
    left: 20px;
  }

  .pickup-next {
    right: 20px;
  }

  .pickup-arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  /* =========================
     スマートフォン
  ========================= */

