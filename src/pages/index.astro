<script>
  const setupPickupSlider = () => {
    const slider = document.querySelector("#pickup-slider");
    const prevBtn = document.querySelector("#prevBtn");
    const nextBtn = document.querySelector("#nextBtn");

    if (!slider || !prevBtn || !nextBtn) return;

    // 移動距離を取得
    const getScrollAmount = () => {
      const card = slider.querySelector(".pickup-card");

      if (!card) return slider.clientWidth;

      const cardWidth = card.getBoundingClientRect().width;
      const style = getComputedStyle(slider);
      const gap = parseFloat(style.columnGap) || 0;

      return cardWidth + gap;
    };

    // ボタンの表示状態を更新
    const updateButtons = () => {
      const maxScroll =
        slider.scrollWidth - slider.clientWidth;

      prevBtn.disabled = slider.scrollLeft <= 1;
      nextBtn.disabled =
        slider.scrollLeft >= maxScroll - 1;
    };

    // 前へ
    prevBtn.addEventListener("click", () => {
      slider.scrollBy({
        left: -getScrollAmount(),
        behavior: "smooth"
      });
    });

    // 次へ
    nextBtn.addEventListener("click", () => {
      slider.scrollBy({
        left: getScrollAmount(),
        behavior: "smooth"
      });
    });

    // スクロール時
    slider.addEventListener("scroll", updateButtons, {
      passive: true
    });

    // 画面サイズ変更時
    window.addEventListener("resize", updateButtons);

    // 初期化
    updateButtons();

    // 画像読み込み後
    slider.querySelectorAll("img").forEach((img) => {
      if (!img.complete) {
        img.addEventListener("load", updateButtons, {
          once: true
        });
      }
    });
  };

  setupPickupSlider();
</script>

