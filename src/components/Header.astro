---
import { navigation, quickLinks } from '../data/navigation';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href={url('/')} aria-label={`${site.shortTitle} トップページ`}>
      <span class="logo-no">77</span>
      <span class="logo-name">駒場祭</span>
    </a>
    <div class="actions">
      <nav class="lang" aria-label="言語切替">
        <a href={url('/')} lang="ja" aria-current="true">JA</a>
        <a href={url('/en/')} lang="en">EN</a>
      </nav>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="global-menu" data-menu-toggle>
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span data-menu-label>MENU</span>
      </button>
    </div>
  </div>

  <div id="global-menu" class="menu" data-menu inert>
    <div class="container">
      <ul class="menu-quick">
        {quickLinks.map((item) => (
          <li><a href={url(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <nav class="menu-groups" aria-label="グローバルナビゲーション">
        {navigation.map((group) => (
          <section>
            <h2>{group.title}</h2>
            <ul>
              {group.items.map((item) => (
                <li><a href={url(item.href)}>{item.label}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      menu.toggleAttribute('inert', !open);
      document.documentElement.classList.toggle('is-menu-open', open);
      if (label) label.textContent = open ? 'CLOSE' : 'MENU';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // メニュー内リンク押下で閉じる（ページ内アンカー移動時の対策）
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-inline: clamp(16px, 4vw, 40px);
    border-bottom: 1px solid var(--c-line);
    background: rgb(255 250 242 / 0.92);
    backdrop-filter: blur(8px);
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-display);
    font-weight: 900;
    text-decoration: none;
  }

  .logo-no {
    font-size: 1.7rem;
    line-height: 1;
    color: var(--c-primary);
  }

  .logo-name {
    font-size: 1.15rem;
    letter-spacing: 0.12em;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lang {
    display: flex;
    gap: 4px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .lang a {
    padding: 2px 8px;
    border-radius: 6px;
    color: var(--c-muted);
    text-decoration: none;
  }

  .lang a[aria-current='true'] {
    background: var(--c-primary);
    color: #fff;
  }

  .menu-btn {
    display: grid;
    justify-items: center;
    gap: 5px;
    width: 56px;
    padding: 9px 0 7px;
    border: 0;
    border-radius: 12px;
    background: var(--c-primary);
    color: #fff;
    font: 700 0.6rem/1 var(--font-base);
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .bars {
    position: relative;
    width: 22px;
    height: 14px;
  }

  .bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s, opacity 0.3s, top 0.3s;
  }

  .bars span:nth-child(1) {
    top: 0;
  }

  .bars span:nth-child(2) {
    top: 6px;
  }

  .bars span:nth-child(3) {
    top: 12px;
  }

  .menu-btn[aria-expanded='true'] .bars span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .bars span:nth-child(2) {
    opacity: 0;
  }

  .menu-btn[aria-expanded='true'] .bars span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    padding: calc(var(--header-h) + 48px) 0 64px;
    background: var(--c-bg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
  }

  .menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .menu-quick {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }

  .menu-quick a {
    display: block;
    padding: 14px 8px;
    border-radius: var(--radius);
    background: var(--c-primary);
    color: #fff;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .menu-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px 40px;
  }

  .menu-groups h2 {
    margin: 0 0 8px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--c-primary);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .menu-groups ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-groups a {
    display: block;
    padding: 8px 0;
    text-decoration: none;
    transition: color 0.2s, translate 0.2s;
  }

  .menu-groups a:hover {
    color: var(--c-primary-dark);
    translate: 4px 0;
  }

  :global(html.is-menu-open) {
    overflow: hidden;
  }
</style>