---
import { sponsorTiers } from '../data/home';
import { url } from '../lib/url';
---

{sponsorTiers.map((tier) => (
  <ul class={`list ${tier.size}`}>
    {tier.items.map((sponsor) => (
      <li>
        {sponsor.href ? (
          <a class="item" href={sponsor.href} target="_blank" rel="noopener sponsored">
            {sponsor.logo ? <img src={url(sponsor.logo)} alt={sponsor.name} loading="lazy" /> : sponsor.name}
          </a>
        ) : (
          <span class="item">
            {sponsor.logo ? <img src={url(sponsor.logo)} alt={sponsor.name} loading="lazy" /> : sponsor.name}
          </span>
        )}
      </li>
    ))}
  </ul>
))}

<style>
  .list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    place-items: center;
    padding: 8px;
    border: 1px solid var(--c-line);
    border-radius: 12px;
    background: #fff;
    color: var(--c-muted);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  a.item:hover {
    border-color: var(--c-primary);
    color: var(--c-text);
  }

  .lg .item {
    width: min(200px, 42vw);
    height: 80px;
  }

  .md .item {
    width: min(150px, 42vw);
    height: 60px;
    font-size: 0.85rem;
  }

  .item img {
    max-width: 90%;
    max-height: 80%;
    object-fit: contain;
  }
</style>