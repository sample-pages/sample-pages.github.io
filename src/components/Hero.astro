---
import { site } from '../data/site';

const { event } = site;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container inner">
    <h1 id="hero-title" class="title">
      <span class="no">第77回</span>
      <span class="name">駒場祭</span>
      <span class="theme">{site.theme}</span>
    </h1>
    <p class="date">
      <span class="year">{event.year}</span>
      <span class="md">{event.start.date}</span>
      <span class="dow">（{event.start.day}）</span>
      <span class="tilde">〜</span>
      <span class="md">{event.end.date}</span>
      <span class="dow">（{event.end.day}）</span>
    </p>
    <p class="hours">{event.hours}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(64px, 12vw, 140px) clamp(120px, 16vw, 200px);
    background: linear-gradient(180deg, #ffd9a8 0%, #ffeedd 60%, var(--c-bg) 100%);
    text-align: center;
  }

  /* 朝日のモチーフ */
  .hero::before {
    content: '';
    position: absolute;
    top: 8%;
    left: 50%;
    width: min(80vw, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #ffb35c 0%, rgb(245 150 42 / 0.3) 55%, transparent 70%);
    translate: -50% 0;
  }

  /* 丘陵のモチーフ */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto -10% -1px;
    height: 36%;
    background:
      radial-gradient(60% 100% at 25% 100%, #f3c58c 0 60%, transparent 61%),
      radial-gradient(55% 90% at 80% 100%, #f8d6aa 0 60%, transparent 61%);
  }

  .inner {
    position: relative;
    z-index: 1;
  }

  .title {
    display: grid;
    gap: 4px;
    margin: 0;
    font-family: var(--font-display);
    line-height: 1.15;
  }

  .no {
    font-size: clamp(1.1rem, 3vw, 1.7rem);
    letter-spacing: 0.25em;
    color: var(--c-primary-dark);
  }

  .name {
    font-size: clamp(3.4rem, 13vw, 7.5rem);
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .theme {
    padding-left: 0.5em;
    font-size: clamp(1.3rem, 4vw, 2.2rem);
    letter-spacing: 0.5em;
    color: var(--c-primary-dark);
  }

  .date {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    margin: 32px 0 4px;
    font-family: var(--font-display);
    font-weight: 900;
  }

  .year {
    margin-right: 0.6em;
    font-size: clamp(1rem, 2.5vw, 1.4rem);
  }

  .md {
    font-size: clamp(2.4rem, 8vw, 4.2rem);
    line-height: 1;
  }

  .dow {
    font-size: clamp(0.85rem, 2vw, 1.15rem);
  }

  .tilde {
    margin-inline: 0.2em;
    font-size: clamp(1.4rem, 4vw, 2.2rem);
  }

  .hours {
    margin: 0;
    font-weight: 700;
    color: var(--c-muted);
  }
</style>