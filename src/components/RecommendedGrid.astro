---
import { recommended } from '../data/home';
import { url } from '../lib/url';
---

<ul class="grid">
  {recommended.map((cat) => (
    <li>
      <a class="card" href={url(`/recommended/${cat.slug}/`)} style={`--card-color: ${cat.color}`}>
        <span class="visual" aria-hidden="true">
          {cat.image ? <img src={url(cat.image)} alt="" loading="lazy" /> : <span class="glyph">{cat.glyph}</span>}
        </span>
        <span class="label">{cat.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 40px) clamp(8px, 3vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    justify-items: center;
    gap: 12px;
    text-align: center;
    text-decoration: none;
  }

  .visual {
    display: grid;
    place-items: center;
    width: min(100%, 180px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid var(--card-color);
    border-radius: 50%;
    background: color-mix(in srgb, var(--card-color) 16%, #fff);
    transition: transform 0.25s;
  }

  .card:hover .visual {
    transform: translateY(-6px) rotate(-4deg);
  }

  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .glyph {
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 900;
    line-height: 1;
    color: var(--card-color);
  }

  .label {
    font-size: clamp(0.8rem, 2.4vw, 1.05rem);
    font-weight: 700;
    line-height: 1.5;
  }
</style>