---
import { officialContents } from '../data/home';
import { url } from '../lib/url';
---

<div class="carousel" data-carousel>
  <ul class="track" data-track>
    {officialContents.map((item) => (
      <li class="slide">
        <a class="card" href={url(item.href)} style={`--card-color: ${item.color}`}>
          <span class="thumb">
            {item.image ? (
              <img src={url(item.image)} alt={item.alt} loading="lazy" />
            ) : (
              <span class="thumb-text" aria-hidden="true">{item.en}</span>
            )}
          </span>
          <span class="body">
            <span class="en">{item.en}</span>
            <span class="ja">{item.title}</span>
            <span class="more">view more</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="controls">
    <button class="nav" type="button" data-dir="-1" aria-label="前のコンテンツ">‹</button>
    <button class="nav" type="button" data-dir="1" aria-label="次のコンテンツ">›</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;

    const step = () => {
      const slide = track.querySelector<HTMLElement>('.slide');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return slide ? slide.offsetWidth + gap : track.clientWidth;
    };

    // 端に達したら反対側へ戻る（原典のループスライダー相当）
    const go = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      if (dir > 0 && track.scrollLeft >= max - 1) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else if (dir < 0 && track.scrollLeft <= 1) {
        track.scrollTo({ left: max, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: dir * step(), behavior: 'smooth' });
      }
    };

    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((button) => {
      button.addEventListener('click', () => go(Number(button.dataset.dir)));
    });
  });
</script>

<style>
  .track {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 8px 4px 28px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 4px;
    scrollbar-width: none;
    list-style: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 min(82%, 340px);
    scroll-snap-align: start;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: var(--c-surface);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition: transform 0.25s;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, color-mix(in srgb, var(--card-color) 65%, #fff), var(--card-color));
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-text {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #fff;
  }

  .body {
    display: grid;
    gap: 4px;
    padding: 20px 24px 24px;
  }

  .en {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--card-color);
  }

  .ja {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .more {
    justify-self: end;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--c-muted);
  }

  .more::after {
    content: ' →';
  }

  .controls {
    display: flex;
    justify-content: center;
    gap: 16px;
  }

  .nav {
    width: 48px;
    height: 48px;
    border: 2px solid var(--c-primary);
    border-radius: 50%;
    background: #fff;
    color: var(--c-primary);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .nav:hover {
    background: var(--c-primary);
    color: #fff;
  }
</style>